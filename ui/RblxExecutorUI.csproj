<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>cesi</AssemblyName>
    <RootNamespace>RblxExecutorUI</RootNamespace>
    <Product>cesi</Product>
    <Version>1.1.0</Version>
    <Title>cesi</Title>
    <ApplicationIcon>Assets/Brand/cesi.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lua.xshd" LogicalName="cesi.Lua.xshd"/>
    <EmbeddedResource Include="Localization/catalog.json" LogicalName="cesi.Localization.json"/>
    <Resource Include="Assets/Brand/*.png" />
    <Resource Include="Assets/Brand/cesi.ico" />
    <None Update="Lua.xshd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
